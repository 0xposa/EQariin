{
  "surah_number": 1,
  "surah_name": "Al-Fatihah",
  "revelation_place": "Makkiyyah",
  "ayat_count": 7,
  "ayat": [
    {
      "ayat_number": 1,
      "text": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "ayat_number": 2,
      "text": "اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِيْنَۙ"
    },
    {
      "ayat_number": 3,
      "text": "الرَّحْمٰنِ الرَّحِيْمِۙ"
    },
    {
      "ayat_number": 4,
      "text": "مٰلِكِ يَوْمِ الدِّيْنِۗ"
    },
    {
      "ayat_number": 5,
      "text": "اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَعِيْنُۗ"
    },
    {
      "ayat_number": 6,
      "text": "اِهْدِنَا الصِّرَاطَ الْمُسْتَقِيْمَۙ"
    },
    {
      "ayat_number": 7,
      "text": "صِرَاطَ الَّذِيْنَ اَنْعَمْتَ عَلَيْهِمْ ە۠ غَيْرِ الْمَغْضُوْبِ عَلَيْهِمْ وَلَا الضَّاۤلِّيْنَ ࣖ"
    }
  ]
}
